# ==============================================================================
# LedgerLine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual settings.
# Do not commit real passwords, secrets, or API keys to version control.
# ==============================================================================

# Application Information
PROJECT_NAME="LedgerLine"
ENVIRONMENT="development"
DEBUG=true

# API Configuration
API_V1_STR="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# CORS Configuration (comma-separated list of allowed browser origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="postgres_user_placeholder"
POSTGRES_PASSWORD="postgres_password_placeholder"
POSTGRES_DB="postgres_db_placeholder"

# Redis Distributed Cache & Rate Limiting Configuration
REDIS_URL="redis://127.0.0.1:6379/0"

# Authentication & JWT Configuration
# Required: Must be at least 32 characters long. Startup fails if missing or weak.
JWT_SECRET_KEY="replace_with_at_least_32_characters_random_secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Local Development Seed Passwords (Ignored in production)
SEED_ADMIN_PASSWORD="optional_seed_admin_password_min_8_chars"
SEED_HOLDER_PASSWORD="optional_seed_holder_password_min_8_chars"
SEED_AUDITOR_PASSWORD="optional_seed_auditor_password_min_8_chars"

# Frontend Configuration
VITE_API_URL="http://127.0.0.1:8000/api/v1"
