# ==============================================================================
# LedgerLine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual settings.
# Do not commit real passwords, secrets, or API keys to version control.
# ==============================================================================

# Application Information
PROJECT_NAME="LedgerLine"
ENVIRONMENT="development"
DEBUG=true

# API Configuration
API_V1_STR="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# CORS Configuration (comma-separated list of allowed browser origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="postgres_user_placeholder"
POSTGRES_PASSWORD="postgres_password_placeholder"
POSTGRES_DB="postgres_db_placeholder"

# Frontend Configuration
VITE_API_URL="http://127.0.0.1:8000/api/v1"
